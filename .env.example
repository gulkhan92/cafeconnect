# PostgreSQL (async, used by SQLAlchemy + asyncpg)
# Host ports are remapped away from the Postgres/Redis defaults (5432/6379) because
# this machine runs several other projects' containers on those ports already.
DATABASE_URL=postgresql+asyncpg://cafeconnect:cafeconnect@localhost:5540/cafeconnect

# Redis (caching, rate limiting, chat session state)
REDIS_URL=redis://localhost:6390/0

# Auth
JWT_SECRET=change-me-to-a-long-random-value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# LLM providers (free tiers)
GROQ_API_KEY=
GEMINI_API_KEY=

FRONTEND_ORIGIN=http://localhost:5173

ENV=development
